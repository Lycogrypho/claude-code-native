#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import sys
import time
import uuid


def _log(msg: str) -> None:
    if os.environ.get("FAKE_DEBUG"):
        sys.stderr.write(f"[fake-claude] {msg}\n")
        sys.stderr.flush()


def _emit(obj) -> None:
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def _emit_line(line: str) -> None:
    sys.stdout.write(line.rstrip("\n") + "\n")
    sys.stdout.flush()


def _default_session_id() -> str:
    return os.environ.get("FAKE_SESSION_ID") or str(uuid.uuid4())


FAKE_ACCOUNT = {
    "loggedIn": True,
    "authMethod": "claude.ai",
    "apiProvider": "firstParty",
    "email": "not-a-real-account@fake-claude.invalid",
    "orgId": "00000000-0000-0000-0000-000000000000",
    "orgName": "fake-claude stand-in (NOT a real account)",
    "subscriptionType": "max",
}


def _run_auth(rest: list[str]) -> int:
    sub = rest[0] if rest else ""
    if sub == "status":
        _emit(FAKE_ACCOUNT)
        return 0
    if sub == "login":
        sys.stderr.write("fake-claude: `auth login` is not implemented — the stand-in mints no credentials.\n")
        return 1
    sys.stderr.write(f"fake-claude: unsupported auth subcommand {sub!r}\n")
    return 1


def _run_default_smoke() -> int:
    session_id = _default_session_id()
    _emit({
        "type": "system",
        "subtype": "init",
        "session_id": session_id,
        "model": "default",
        "cwd": os.getcwd(),
        "permissionMode": "default",
        "outputStyle": "default",
    })
    try:
        for raw in sys.stdin:
            try:
                msg = json.loads(raw)
            except Exception:
                continue
            if msg.get("type") == "control_request" and msg.get("request", {}).get("subtype") == "initialize":
                _emit({
                    "type": "control_response",
                    "response": {
                        "subtype": "success",
                        "request_id": msg.get("request_id"),
                        "response": {"commands": [], "models": [], "agents": [], "account": {}},
                    },
                })
                break
            if msg.get("type") == "user":
                _emit({"type": "result", "subtype": "success", "result": "ok", "session_id": session_id})
                break
    except KeyboardInterrupt:
        return 0
    return 0


def _run_fixture(path: str) -> int:
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = [ln for ln in f.read().splitlines() if ln.strip()]
    except OSError as e:
        sys.stderr.write(f"fake-claude: cannot read FAKE_FIXTURE {path!r}: {e}\n")
        return 1

    _log(f"loaded {len(lines)} line(s) from {path}")
    for raw in lines:
        try:
            obj = json.loads(raw)
        except Exception:
            _emit_line(raw)
            continue

        if isinstance(obj, dict) and "_sleep_ms" in obj:
            time.sleep(int(obj["_sleep_ms"]) / 1000.0)
            continue

        if isinstance(obj, dict) and obj.get("_wait_stdin"):
            try:
                resp = sys.stdin.readline()
            except KeyboardInterrupt:
                return 0
            if not resp:
                _log("stdin closed while waiting for control_response")
                return 2
            _log(f"consumed stdin: {resp.rstrip()}")
            continue

        _emit(obj)

    try:
        sys.stdin.read()
    except Exception:
        pass
    return 0


def main(argv: list[str]) -> int:
    if len(argv) > 1 and argv[1] == "auth":
        return _run_auth(argv[2:])

    fixture = os.environ.get("FAKE_FIXTURE", "").strip()
    if not fixture:
        return _run_default_smoke()
    return _run_fixture(fixture)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
